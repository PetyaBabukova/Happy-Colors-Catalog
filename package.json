{
  "name": "happy-colors-unified",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "cd server && npm install && cd ../happy-colors-nextjs-project && npm install",
    "install:all": "npm install",
    "build": "cd happy-colors-nextjs-project && npm run build",
    "start": "node server.js",
    "dev": "node server.js",
    "test": "npm run test:server && npm run test:frontend",
    "test:e2e": "node scripts/runPlaywrightE2e.js",
    "test:e2e:smoke": "node scripts/runPlaywrightE2e.js --grep \"@smoke\"",
    "test:e2e:ui": "node scripts/runPlaywrightE2e.js --ui",
    "test:all": "npm run test:ci && npm run test:e2e:smoke",
    "test:coverage": "npm run test:server:coverage && npm run test:frontend:coverage",
    "test:server": "cd server && npm test",
    "test:server:unit": "cd server && npm run test:unit",
    "test:server:integration": "cd server && npm run test:integration",
    "test:server:coverage": "cd server && npm run test:coverage",
    "test:server:ci": "cd server && npm run test:ci",
    "test:frontend": "cd happy-colors-nextjs-project && npm test",
    "test:frontend:unit": "cd happy-colors-nextjs-project && npm run test:unit",
    "test:frontend:unit-jsdom": "cd happy-colors-nextjs-project && npm run test:unit-jsdom",
    "test:frontend:api": "cd happy-colors-nextjs-project && npm run test:api",
    "test:frontend:components": "cd happy-colors-nextjs-project && npm run test:components",
    "test:frontend:coverage": "cd happy-colors-nextjs-project && npm run test:coverage",
    "test:frontend:ci": "cd happy-colors-nextjs-project && npm run test:ci",
    "cleanup:cartoon-uploads": "node scripts/cleanupCartoonOrderUploads.js",
    "cleanup:cartoon-uploads:daily": "node scripts/cleanupCartoonOrderUploads.js --mode=daily",
    "cleanup:cartoon-uploads:weekly-recordless": "node scripts/cleanupCartoonOrderUploads.js --mode=weekly-recordless",
    "estimate:translations": "node scripts/estimateOpenAiTranslationCosts.js",
    "report:english-launch-readiness": "node scripts/reportEnglishLaunchReadiness.js",
    "migrate:category-seo-inventory": "node scripts/freezeCategorySeoInventory.js --dry-run",
    "migrate:category-seo-inventory:dry-run": "node scripts/freezeCategorySeoInventory.js --dry-run",
    "migrate:category-seo-inventory:write": "node scripts/freezeCategorySeoInventory.js --write",
    "migrate:english-localization": "node scripts/backfillEnglishLocalizationFoundation.js --dry-run",
    "migrate:english-localization:dry-run": "node scripts/backfillEnglishLocalizationFoundation.js --dry-run",
    "migrate:english-localization:write": "node scripts/backfillEnglishLocalizationFoundation.js --write",
    "test:ci": "npm run test:server:ci && npm run test:frontend:ci"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "mongoose": "^8.23.1",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
